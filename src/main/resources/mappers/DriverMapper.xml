<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.solvd.dao.IDriverDAO">

    <resultMap id="DriverResultMap" type="com.solvd.model.Driver">
        <id property="id" column="id"/>
        <result property="licenseNumber" column="license_number"/>
        <result property="driverStatus" column="driver_status"/>
        <result property="rating" column="rating"/>
        <result property="hireDate" column="hire_date"/>
        <result property="yearsOfExperience" column="years_of_experience"/>
        <result property="userId" column="user_id"/>
    </resultMap>

    <select id="getAll" resultMap="DriverResultMap">
        SELECT id,
        license_number,
        driver_status,
        rating,
        hire_date,
        years_of_experience,
        user_id
        FROM drivers
    </select>

</mapper>